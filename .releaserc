{
  "repositoryUrl": "git@github.com:Charley3d/lip-sync.git",
  "debug": true,
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "lip_sync_py313-*-linux_x64.zip", "label": "LipSync for Linux ${nextRelease.gitTag}" },
          { "path": "lip_sync_py313-*-macos_arm64.zip", "label": "LipSync for MacOS arm64 ${nextRelease.gitTag}" },
          { "path": "lip_sync_py313-*-macos_x64.zip", "label": "LipSync for MacOS x64 ${nextRelease.gitTag}" },
          { "path": "lip_sync_py313-*-windows_x64.zip", "label": "LipSync for Windows x64 ${nextRelease.gitTag}" }
        ]
      }
    ]
  ]
}
